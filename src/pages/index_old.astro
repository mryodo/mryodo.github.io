---
import Layout from "../layouts/index.astro";
import Right from "../components/right.astro";
// import "../styles/index.css";
const posts = Object.values(import.meta.glob("./news/*.md", { eager: true }));
posts.sort(
  (a, b) => Date.parse(b.frontmatter.sort) - Date.parse(a.frontmatter.sort),
);
const posts2 = posts
  .filter((post) => post.frontmatter.decorator == "alert")
  .slice(0, 3);
---

<Layout title="tony>">
  <div slot="index">
    <div box-="square" shear-="top" class="my-box">
      <div class="header">
        <span> <h2>Hi</h2> </span>
      </div>
      <div class="flex-container">
        <div class="flex-item-left">
          <p>
            I am <strong> Tony Savostianov. </strong> I am a PostDoc at the <strong
              >Computational Network Science</strong
            > at <span is-="badge" variant-="nord10">RWTH Aachen</span> in <i
              >Aachen, Germany</i
            >.
          </p>
          <p style="color: var(--background3);">
            Recently I've defended my PhD in <strong
              style="color: var(--foreground2) !important ;"
              >Mathematics in Natural Science</strong
            > at <a
              href="https://gssi.it"
              style="color: var(--foreground2) !important;"
              >Gran Sasso Science Institute</a
            > in <i> L'Aquila, Italy</i>.
          </p>
          <br />
          <p>
            My current work is focuses on the numerical methods for <mark
              >Network Science</mark
            >. My previous work included:

            <ul marker-="open tree">
              <li>
                &#xf1796; coupled (nonlinear) oscillators for modelling solar
                activity
              </li>
              <li>
                &#xed7d; detection of 3D structure in chromatine via CV methods
              </li>
              <li>
                &#xf019a; quasi stationary points in spatially-heterogeneous
                models of biocommuinites
              </li>
            </ul>

            <br />
            <br />
            <p>
              <span is-="badge" cap-="round"><a href="/news">news</a></span>
              <span is-="badge" cap-="round"
                ><a href="/research">research</a></span
              >
              <span is-="badge" cap-="round"><a href="/papers">papers</a></span>
              <span is-="badge" cap-="round"
                ><a href="/teaching">teaching</a></span
              >
            </p>

            <br />

            <div class="updates">
              <h3>last updates</h3>

              {
                posts2.map((post) => (
                  <div
                    box-="square"
                    shear-="top"
                    class={post.frontmatter.decorator}
                  >
                    <div class="header">
                      <span
                        is-="badge"
                        variant-={
                          post.frontmatter.decorator == "post"
                            ? "foreground0"
                            : "background0"
                        }
                      >
                        {" "}
                        {post.frontmatter.date}{" "}
                      </span>
                      <span>
                        {post.frontmatter.link.map((link) => (
                          <span
                            is-="badge"
                            variant-={
                              post.frontmatter.decorator == "post"
                                ? "foreground0"
                                : "background0"
                            }
                          >
                            <a href={link[0]}>{link[1]}</a>
                          </span>
                        ))}
                      </span>
                    </div>
                    <div set:html={post.compiledContent()} />
                  </div>
                ))
              }
            </div>
          </p>
        </div>
        <div class="flex-item-right">
          <Right />
        </div>
      </div>
    </div>
  </div>
</Layout>
