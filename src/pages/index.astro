---
import Layout from "../layouts/index.astro";
import Right from "../components/right.astro";
import Intro from "../components/intro.astro";
import Updates from "../components/updates.astro";
import "../styles/index.css";
const posts = Object.values(import.meta.glob("./news/*.md", { eager: true }));
posts.sort(
  (a, b) => Date.parse(b.frontmatter.sort) - Date.parse(a.frontmatter.sort),
);
const posts2 = posts
  .filter((post) => post.frontmatter.decorator == "alert")
  .slice(0, 3);
---

<Layout title="tony>">
  <div slot="index">
    <div box-="square" shear-="top">
      <!-- NOTE: heeader -->
      <div class="header">
        <span> <h1>Hi</h1> </span>
      </div>

      <!-- NOTE: two column setup -->
      <div class="container">
        <article class="card">
          <div class="left-content">
            <Intro />
            <Updates posts2={posts2} />
          </div>
          <div class="card-content">
            <Right />
          </div>
        </article>
      </div>
    </div>
  </div>
</Layout>
