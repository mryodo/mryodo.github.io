---
import "../styles/global.css";
import "../styles/mdx.css";
import Layout from "../layout";
import { AsciiBox } from "@/components/ascii/ascii-box";
import { NewsGroup } from "@/components/content/news-group";
import { NewsItem } from "@/components/content/news-item";
import { getNews } from "@/lib/news";
import { GrSolaris } from "react-icons/gr";
import { FaDna } from "react-icons/fa";
import { PiCowFill } from "react-icons/pi";

const latestNews = (await getNews()).slice(0, 3);

const title = "tony";
const pageDescription =
  "Tony Savostianov — applied math researcher in Network Science at RWTH Aachen.";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={pageDescription} />
    <title>{title}</title>
  </head>
  <body>
    <Layout client:idle>
      <div class="mdx">
        <h2>Hi!</h2>

        <p>
          I am <strong>Tony Savostianov</strong>. I am a PostDoc at the{" "}
          <strong>Computational Network Science</strong> at{" "}
          <mark>RWTH Aachen</mark> in <em>Aachen, Germany</em>.
        </p>
        <p>
          <span class="dim">
            Recently I've defended my PhD in <strong
              >Mathematics in Natural Science</strong
            > at{" "}
            <a href="https://gssi.it/">Gran Sasso Science Institute</a> in <em
              >L'Aquila, Italy</em
            >.{" "}
          </span>
        </p>

        <br />

        <p>
          My current work is focuses on the <b>numerical methods</b> for <mark
            ><b>Network Science</b></mark
          >. My previous work included:
        </p>

        <AsciiBox fluid bg="bg-card" className="w-full">
          <ul>
            <li>
              <GrSolaris />
              {" "}coupled (nonlinear) oscillators for modelling solar activity
            </li>
            <li>
              <FaDna />
              {" "}detection of 3D structure in chromatine via CV methods
            </li>
            <li>
              <PiCowFill />
              {" "}quasi stationary points in spatially-heterogeneous models of
              biocommuinites
            </li>
          </ul>
        </AsciiBox>

        <AsciiBox fluid bg="bg-card" className="w-full">
          <div>
            <NewsGroup
              label="last updates"
              count={latestNews.length}
              defaultOpen
            >
              {
                latestNews.map((item) => (
                  <NewsItem
                    date={item.date}
                    danger={item.decorator === "alert"}
                    links={item.link}
                    html={item.bodyHtml}
                  />
                ))
              }
            </NewsGroup>
          </div>
        </AsciiBox>
      </div>
    </Layout>
  </body>
</html>
