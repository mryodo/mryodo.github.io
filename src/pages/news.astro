---
import "../styles/global.css";
import "../styles/mdx.css";
import Layout from "../layout";
import { Thread } from "@/components/content/thread";
import { NewsItem } from "@/components/content/news-item";
import { getNews } from "@/lib/news";

const news = await getNews();

const groups = news.reduce<{ year: string; items: typeof news }[]>(
  (acc, item) => {
    const last = acc[acc.length - 1];
    if (last && last.year === item.year) {
      last.items.push(item);
    } else {
      acc.push({ year: item.year, items: [item] });
    }
    return acc;
  },
  [],
);

const title = "news";
const pageDescription =
  "Quick updates — published work, planned talks, and travelling.";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={pageDescription} />
    <title>{title}</title>
  </head>
  <body>
    <Layout path={Astro.url.pathname} client:idle>
      <div class="mdx">
        <h2>Updates</h2>

        <p>Here you can find a quick list of updates on my work. Enjoy!</p>


        <p>
          This list consists of quick, typically one-line, updates on the
          published work, planned talks, and travelling. More detailed
          descriptions of the published papers can be found{" "}
          <a href="/papers">here</a>.
        </p>


        {
            groups.map((group, i) => (
              <Thread
                title={group.year}
                count={group.items.length}
                noun="update"
                defaultOpen={i === 0}
              >
                {group.items.map((item) => (
                  <NewsItem
                    date={item.date}
                    danger={item.decorator === "alert"}
                    links={item.link}
                    html={item.bodyHtml}
                  />
                ))}
              </Thread>
            ))
        }
      </div>
    </Layout>
  </body>
</html>
