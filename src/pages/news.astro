---
import Layout from "../layouts/index.astro";
import Right from "../components/right.astro";
import "../styles/news.css";
import NewsList from "../components/news.astro";
const posts = Object.values(import.meta.glob("./news/*.md", { eager: true }));
posts.sort(
  (a, b) => Date.parse(b.frontmatter.sort) - Date.parse(a.frontmatter.sort),
);
const posts2025 = posts.filter((post) => post.frontmatter.year == "2025");
const posts2024 = posts.filter((post) => post.frontmatter.year == "2024");
const posts2023 = posts.filter((post) => post.frontmatter.year == "2023");
const posts2022 = posts.filter((post) => post.frontmatter.year == "2022");
---

<Layout title="tony>news">
  <div slot="index">
    <div box-="square" shear-="top">
      <!-- NOTE: heeader -->
      <div class="header">
        <span> <h1>Updates</h1> </span>
      </div>

      <!-- NOTE: two column setup -->
      <div class="container">
        <article class="card">
          <div class="left-content">
            <p>Here you can find a quick lists of updates on my work. Enjoy!</p>

            <br />

            <p>
              This list consists of quick, typically one-line, updates on the
              published work, planned talks, and travelling. More detailed
              descriptions of the published papers can be found <a
                href="/papers">here</a
              >.
            </p>

            <br />

            <details open>
              <summary class="current"> ## 2025 ({posts2025.length})</summary>
              <NewsList posts={posts2025} />
            </details>

            <br />

            <details>
              <summary class="old"> ### 2024 ({posts2024.length}) </summary>
              <NewsList posts={posts2024} />
            </details>

            <details>
              <summary class="old"> ### 2023 ({posts2023.length})</summary>
              <NewsList posts={posts2023} />
            </details>

            <details>
              <summary class="old"> ### 2022 ({posts2022.length})</summary>
              <NewsList posts={posts2022} />
            </details>
          </div>
          <div class="card-content">
            <Right />
          </div>
        </article>
      </div>
    </div>
  </div>
</Layout>
