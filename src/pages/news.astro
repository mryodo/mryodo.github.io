---
import "../styles/global.css";
import "../styles/mdx.css";
import Layout from "../layout";
import { AsciiBox, AsciiRule } from "@/components/ascii/ascii-box";
import { NewsGroup } from "@/components/content/news-group";
import { NewsItem } from "@/components/content/news-item";
import { getNews } from "@/lib/news";

const news = await getNews();

const groups = news.reduce<{ year: string; items: typeof news }[]>(
  (acc, item) => {
    const last = acc[acc.length - 1];
    if (last && last.year === item.year) {
      last.items.push(item);
    } else {
      acc.push({ year: item.year, items: [item] });
    }
    return acc;
  },
  [],
);

const title = "news";
const pageDescription =
  "Quick updates — published work, planned talks, and travelling.";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={pageDescription} />
    <title>{title}</title>
  </head>
  <body>
    <Layout client:idle>
      <div class="mdx">
        <h1>Updates</h1>

        <p>Here you can find a quick list of updates on my work. Enjoy!</p>

        <br />

        <p>
          This list consists of quick, typically one-line, updates on the
          published work, planned talks, and travelling. More detailed
          descriptions of the published papers can be found{" "}
          <a href="/papers">here</a>.
        </p>

        <br />

        <AsciiBox fluid bg="bg-card" className="w-full" title="updates">
          <div className="flex flex-col">
            {
              groups.map((group, i) => (
                <>
                  {i > 0 && <AsciiRule className="my-[0.5lh] opacity-50" />}
                  <NewsGroup
                    label={group.year}
                    count={group.items.length}
                    defaultOpen={i === 0}
                  >
                    {group.items.map((item) => (
                      <NewsItem
                        date={item.date}
                        danger={item.decorator === "alert"}
                        links={item.link}
                        html={item.bodyHtml}
                      />
                    ))}
                  </NewsGroup>
                </>
              ))
            }
          </div>
        </AsciiBox>
      </div>
    </Layout>
  </body>
</html>
