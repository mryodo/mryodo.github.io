---
import Layout from "../layouts/index.astro";
import Navbar from "../components/navbar.astro";

import Right from "../components/right.astro";
---

<Layout title="tony>research">
  <div slot="index">
    <div box-="square" shear-="top">
      <!-- NOTE: heeader -->
      <div class="header">
        <span> <h1>Research</h1> </span>
      </div>

      <!-- NOTE: two column setup -->
      <div class="container">
        <article class="card">
          <div class="left-content">
            <p>Here you can find a quick lists of updates on my work. Enjoy!</p>

            <br />

            <p>For now probably just contact me, why not?</p>

            <br />
          </div>
          <div class="card-content">
            <Right />
          </div>
        </article>
      </div>
    </div>
  </div>
</Layout>
