---
import "../styles/global.css";
import "../styles/navbar.css";
const { title = "home" } = Astro.props;
---

<!-- TODO: update the flex containers to modern CSS standard -->
<nav>
  <div class="flex-container">
    <div class="flex-item-left">
      <span is-="badge" cap-="round square" variant-="blue"
        ><a href="/">&#xe83d; <span class="topname">tony</span></a></span
      >
      <span is-="badge" cap-="square round" variant-="fg0">{title}</span>
    </div>
    <div class="flex-item-right">
      <span is-="badge" cap-="round square" variant-="orange"
        ><a href="/news">&#xf06b0;</a></span
      >
      <span is-="badge" variant-="orange"><a href="/research">&#xeeac;</a></span
      >
      <span is-="badge" variant-="orange"><a href="/papers">&#xf16c9;</a></span>
      <span is-="badge" variant-="orange"><a href="/teaching">&#xf19c;</a></span
      >
      <span is-="badge" cap-="square round" variant-="teal">menu</span>
    </div>
  </div>
</nav>
