---
const { posts2 = "" } = Astro.props;
import "../styles/updates.css";
import "../styles/global.css";
---

<div class="updates">
  <h3>last updates</h3>
  {
    posts2.map((post) => (
      <div box-="square" shear-="top" class={post.frontmatter.decorator}>
        <div class="header">
          <span
            is-="badge"
            cap-="round"
            style="background-color: transparent"
            variant-={post.frontmatter.decorator == "post" ? "fg1" : "bg1"}
          >
            {post.frontmatter.decorator} {post.frontmatter.date}{" "}
          </span>
          <span>
            {post.frontmatter.link.map((link) => (
              <span
                is-="badge"
                cap-="round"
                style="background-color: transparent"
                variant-={post.frontmatter.decorator == "post" ? "fg1" : "bg1"}
              >
                <a href={link[0]}>{link[1]}</a>
              </span>
            ))}
          </span>
        </div>
        <div set:html={post.compiledContent()} />
      </div>
    ))
  }
</div>
